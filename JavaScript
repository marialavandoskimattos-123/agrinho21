// O evento DOMContentLoaded garante que os botões só escutem cliques após estarem prontos na tela
document.addEventListener('DOMContentLoaded', () => {
    
    // Seleção segura de elementos
    const themeToggleBtn = document.getElementById('theme-toggle');
    const actionBtn = document.getElementById('btn-action');
    const nameInput = document.getElementById('user-name');
    const mainTitle = document.getElementById('main-title');
    const subTitle = document.getElementById('sub-title');
    const inputWrapper = document.getElementById('input-wrapper');

    // 1. REPARO DO MODO ESCURO/CLARO
    if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('dark-mode');
            
            // Verifica se a classe foi adicionada e altera o texto do botão
            const isDark = document.body.classList.contains('dark-mode');
            themeToggleBtn.textContent = isDark ? "☀️ Modo Claro" : "🌓 Modo Escuro";
        });
    }

    // 2. REPARO DA VALIDAÇÃO E BOAS-VINDAS
    if (actionBtn) {
        actionBtn.addEventListener('click', () => {
            const visitorName = nameInput.value.trim();

            if (visitorName !== "") {
                // Altera o conteúdo de texto da página de forma funcional
                mainTitle.innerHTML = `Bem-vindo, <span style="color: var(--accent-color);">${visitorName}</span>!`;
                subTitle.textContent = "Seu painel interativo sobre sustentabilidade no campo foi gerado.";
                
                // Remove o input e botão e exibe mensagem de sucesso
                inputWrapper.innerHTML = `<p style="color: var(--accent-color); font-weight: 700; width: 100%;">🌿 Conectado com sucesso ao Futuro Sustentável!</p>`;
            } else {
                // Alerta suave caso tente clicar sem digitar
                nameInput.style.borderColor = "#e53935";
                nameInput.placeholder = "Por favor, digite seu nome primeiro...";
            }
        });
    }
});
